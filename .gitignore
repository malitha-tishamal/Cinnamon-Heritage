# ============================================================
# Cinnamon Heritage — Git Ignore Rules
# ============================================================

# 1. Environment & Secret Config Files
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
js/config.js

# 2. Local Backup Folder (Created for secure offline storage)
backup_secret_files/
gitignored_files_backup/

# 3. Database Dumps & SQL Migration Files
*.sql
bank_update.sql
cinnamon_heritage.sql
database.sql
ecommerce_advanced.sql
ecommerce_update.sql
footer_database.sql
footer_update.sql
supabase_setup.sql

# 4. Scratch & Testing Scripts (Contain DB keys)
scratch/

# 5. Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 6. Sensitive Architecture Reports & PDFs
*.pdf
*.docx
*.pptx

# 7. Operating System & Editor Files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
